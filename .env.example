DATABASE_URL="postgresql://usuario:senha@host:5432/clinica?schema=public"
AUTH_SECRET="troque-por-um-segredo-forte-e-aleatorio"
NEXT_PUBLIC_APP_URL="https://seusite.com"
NEXT_PUBLIC_GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_ID=""
